          "password": "Password"
        },
        "data_description": {
          "password": "The current password of the NOM account."
        }
      },
      "reconfigure": {
        "title": "Update credentials",
        "description": "Change the credentials of this NOM account.",
        "data": {
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "username": "Must be the same account as before.",
          "password": "The current password of the NOM account."
        }
      }
    },
